Reach_APP_ENV=development
Reach_DATABASE_URL=postgresql+psycopg://Reach:Reach@db:5432/Reach
Reach_AUTH_TOKEN_SECRET=change-this-secret
Reach_MAGIC_LINK_BASE_URL=http://127.0.0.1:3000
Reach_MAGIC_LINK_TTL_MINUTES=15
Reach_DEV_MAGIC_LINK_MODE=response
Reach_DEV_DEFAULT_ROLE=volunteer
Reach_DEV_AUTO_CREATE_USERS=true

# Legacy Apps Script ingest endpoint. Not required for the Incident-scoped
# Google Sheets importer unless you still use POST /ingest/google-form.
Reach_GOOGLE_FORM_INGEST_TOKEN=

# Backend-only Google Sheets importer configuration. Do not expose these through
# NEXT_PUBLIC_* variables.
Reach_GOOGLE_SHEETS_IMPORT_ENABLED=false
Reach_GOOGLE_SERVICE_ACCOUNT_JSON=
Reach_DEMO_GOOGLE_SHEET_NAME=Form Responses 1

# Background safety-net polling for active Google Sheets intake sources. Use the
# Apps Script onFormSubmit webhook for immediate imports.
Reach_INTAKE_AUTO_SYNC_ENABLED=false
Reach_INTAKE_AUTO_SYNC_INTERVAL_SECONDS=300

Reach_REPORT_ATTACHMENT_STORAGE_DIR=/tmp/Reach/report_attachments
Reach_REPORT_ATTACHMENT_MAX_UPLOAD_BYTES=8388608
Reach_REPORT_ATTACHMENT_MAX_FILES=4

API_INTERNAL_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Legacy homepage form links. Incident-scoped intake reads the public form URL
# from incident_intake_sources.google_form_url instead.
NEXT_PUBLIC_SAFE_REPORT_FORM_URL=
NEXT_PUBLIC_MISSING_REPORT_FORM_URL=
NEXT_PUBLIC_UPDATE_REPORT_FORM_URL=

NEXT_PUBLIC_COMMUNITY_BOARD_URL=
NEXT_PUBLIC_COMMUNITY_BOARD_EMBED_URL=
NEXT_PUBLIC_ENABLE_STAFF_DASHBOARD_MOCKS=false
